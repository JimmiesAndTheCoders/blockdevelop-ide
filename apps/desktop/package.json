{
  "name": "@blockdevelop/desktop",
  "version": "0.2.0-beta.6",
  "description": "Free open-source IDE for visual block-based programming.",
  "author": "BlockDevelop IDE Team <contact@blockdevelop.dev>",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/JimmiesAndTheCoders/blockdevelop-ide.git",
    "directory": "apps/desktop"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "package": "pnpm run build && electron-builder",
    "package:dir": "pnpm run build && electron-builder --dir",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.blockdevelop.ide",
    "productName": "BlockDevelop IDE",
    "directories": {
      "output": "release/${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "JimmiesAndTheCoders",
      "repo": "blockdevelop-ide"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "BlockDevelop-IDE-macOS-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "forceCodeSigning": false
    },
    "nsis": {
      "artifactName": "BlockDevelop-IDE-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "BlockDevelop-IDE-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "BlockDevelop IDE Team <contact@blockdevelop.dev>",
      "artifactName": "BlockDevelop-IDE-Linux-${version}.${ext}"
    },
    "deb": {
      "packageName": "blockdevelop-ide",
      "artifactName": "blockdevelop-ide_${version}_amd64.deb"
    }
  },
  "dependencies": {
    "@blockdevelop/block-engine": "workspace:*",
    "@blockdevelop/code-gen": "workspace:*",
    "@blockdevelop/core": "workspace:*",
    "@blockdevelop/ui": "workspace:*",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "happy-dom": "^13.8.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.3.1"
  }
}
